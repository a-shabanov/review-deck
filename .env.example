# Absolute paths on the Docker host, separate directories. No quotes needed unless the value contains #.
REVIEW_DECK_LIBRARY=/srv/review-deck/library
REVIEW_DECK_DATA_DIR=/srv/review-deck/data
REVIEW_DECK_BIND_IP=127.0.0.1
REVIEW_DECK_PORT=8765
REVIEW_DECK_UID=10001
REVIEW_DECK_GID=10001
REVIEW_DECK_USER=review
# Set the exact browser origin when using a reverse proxy:
REVIEW_DECK_PUBLIC_ORIGIN=
# Example for HTTPS proxy: https://review.example.internal
